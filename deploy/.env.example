# Copy this file to .env and fill in real values. Never commit the real .env.
#
# Generate each secret with:
#   DB_PASSWORD, APP_JWT_SECRET, BACKUP_PASSPHRASE: openssl rand -base64 32
#   APP_ENCRYPTION_KEY:          python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#   APP_PASSWORD_HASH:           python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_REAL_PASSWORD', bcrypt.gensalt()).decode())"
#
# IMPORTANT: APP_PASSWORD_HASH (bcrypt) contains literal "$" characters
# (e.g. $2b$10$...) — Docker Compose treats "$" as the start of its own
# variable substitution inside .env files, so double every "$" to "$$" or
# the value silently gets mangled. Example: $2b$10$abc -> $$2b$$10$$abc

DB_PASSWORD=
APP_ENCRYPTION_KEY=
APP_JWT_SECRET=
APP_USER=
APP_PASSWORD_HASH=

# Enable only if Ollama is reachable from this VM (M3, optional).
APP_EMBEDDINGS_ENABLED=false
APP_OLLAMA_URL=http://host.docker.internal:11434

# Public hostname the app installs WireGuard clients to point at.
WIREGUARD_SERVER_URL=falcon.whatbox.ca

# Used by backup.sh/restore.sh (M4) — NOT read by docker-compose.yml itself,
# so no $$ escaping needed here even if it contains a literal "$".
BACKUP_PASSPHRASE=
BACKUP_RETENTION_COUNT=14
