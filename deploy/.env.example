# Copy this file to .env, `chmod 600 .env`, and fill in real values. Never
# commit the real .env.
#
# Generate each secret with:
#   DB_PASSWORD, APP_JWT_SECRET, BACKUP_PASSPHRASE: openssl rand -base64 32
#   APP_ENCRYPTION_KEY:          python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#   APP_PASSWORD_HASH:           a fresh cloud VM usually has neither bcrypt
#                                nor htpasswd installed — deploy/generate-
#                                password-hash.sh runs bcrypt in a throwaway
#                                container instead, reading the password
#                                from a file so it never appears in `ps`.
#
# IMPORTANT: APP_PASSWORD_HASH (bcrypt) contains literal "$" characters
# (e.g. $2b$10$...) — Compose treats "$" as the start of its own variable
# substitution inside .env files, so double every "$" to "$$" or the value
# silently gets mangled. Example: $2b$10$abc -> $$2b$$10$$abc
# (generate-password-hash.sh already outputs it pre-doubled.)

DB_PASSWORD=
APP_ENCRYPTION_KEY=
APP_JWT_SECRET=
APP_USER=
APP_PASSWORD_HASH=

# Enable only if Ollama is reachable from this VM (M3, optional — off by
# default here since the target VM has no Ollama).
APP_EMBEDDINGS_ENABLED=false
# "ollama" (local) or "gemini" (needs GEMINI_API_KEY below; asymmetric
# document/query embeddings, generally better retrieval than the small
# local model). Switching providers after memories already exist needs a
# one-time POST /api/v1/admin/reembed — old and new embeddings aren't
# comparable (different vector spaces).
APP_EMBEDDINGS_PROVIDER=ollama
# Must match what the provider actually outputs and the DB column
# (V2/V3 migrations): 768 for ollama/nomic-embed-text (default, matches
# V2), 1536 for gemini (matches V3 — pgvector's HNSW index caps at 2000
# dims, so Gemini's native 3072 isn't usable; 768 measurably hurt
# relevance separation in testing, 1536 is the practical middle ground).
APP_EMBEDDINGS_DIMENSIONS=768
# Coarse sanity ceiling (cosine distance above this = "not related at
# all", discarded outright) — calibrated for ollama/nomic-embed-text.
# Loosen to ~0.5 for gemini; semantic-margin below does the fine cut.
APP_EMBEDDINGS_MAX_DISTANCE=0.42
# How much farther than the single best semantic match another
# candidate can be and still count as a genuine tie (→ asks "qual
# vale?") instead of being discarded. Matters most for gemini, where
# even unrelated short texts measure similar absolute cosine distance —
# 0.02 was picked by measuring real examples locally (15/10), not a
# universal constant.
APP_EMBEDDINGS_SEMANTIC_MARGIN=0.02
APP_OLLAMA_URL=http://host.docker.internal:11434

# Optional: rephrases the final chat answer in natural language and
# suggests search synonyms via the Gemini API (free tier at
# aistudio.google.com) — never sent SENSITIVE memory content, and every
# call falls back silently to the literal/deterministic behavior on any
# failure. Leave APP_GEMINI_ENABLED=false (or GEMINI_API_KEY empty) to
# keep the app fully local/offline for this feature. Not needed just for
# APP_EMBEDDINGS_PROVIDER=gemini above — that only needs GEMINI_API_KEY.
APP_GEMINI_ENABLED=false
GEMINI_API_KEY=

# Public hostname the app installs WireGuard clients to point at — the
# Oracle VM's public/reserved IP, or a DNS name pointed at it.
WIREGUARD_SERVER_URL=

# Used by backup.sh/restore.sh (M4) — NOT read by docker-compose.yml itself,
# so no $$ escaping needed here even if it contains a literal "$".
BACKUP_PASSPHRASE=
BACKUP_RETENTION_COUNT=14
